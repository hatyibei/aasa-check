{
  "name": "aasa-check",
  "version": "0.1.0",
  "private": true,
  "description": "Check iOS Universal Links AASA files in CI: match URLs against applinks patterns and compare your site's AASA with Apple's CDN copy.",
  "type": "module",
  "bin": {
    "aasa-check": "./dist/cli.cjs"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:action",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=cjs --outfile=dist/cli.cjs --banner:js=\"#!/usr/bin/env node\"",
    "build:action": "esbuild src/action.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "start": "node dist/cli.cjs",
    "typecheck": "tsc --noEmit",
    "fixtures": "node dist/cli.cjs fixtures --dir fixtures/unit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "keywords": [
    "ios",
    "universal-links",
    "apple-app-site-association",
    "aasa",
    "applinks",
    "github-action",
    "ci"
  ],
  "files": [
    "dist/cli.cjs",
    "dist/index.cjs",
    "action.yml",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "TODO: set after the GitHub repository is created"
  },
  "homepage": "TODO: set after the GitHub repository is created",
  "bugs": {
    "url": "TODO: set after the GitHub repository is created"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
